; 6-microphone PDM emulator: the ESP32-S3 (daq-detector) is the PDM master and drives CLK;
; three data lines carry two "microphones" each, one per clock half (like SEL low / SEL high mics).
;
; in_base  = CLK pin (input from the ESP32)
; out_base = DATA0, 3 consecutive pins (DATA0, DATA1, DATA2)
;
; Every edge of CLK outputs the next 3 bits (one per line). Autopull with a threshold of 24 bits:
; one FIFO word = 8 clock halves = 4 PDM clock cycles, bits 3k..3k+2 = half k (even k: after the
; rising edge, odd k: after the falling edge). The edge-to-output latency is ~4 system clocks
; (2 for the input synchronizer, 1 for wait, 1 for out), about 20 ns at 200 MHz.

.program pdm_emu
.wrap_target
    wait 1 pin 0        ; rising edge of CLK
    out pins, 3         ; first half of the cycle
    wait 0 pin 0        ; falling edge of CLK
    out pins, 3         ; second half of the cycle
.wrap

% c-sdk {
static inline void pdm_emu_program_init(PIO pio, uint sm, uint offset, uint clk_pin, uint data_pin)
{
    pio_sm_config c = pdm_emu_program_get_default_config(offset);
    sm_config_set_in_pins(&c, clk_pin);
    sm_config_set_out_pins(&c, data_pin, 3);
    sm_config_set_out_shift(&c, true, true, 24);   /* shift right, autopull, 24 bits per word */
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);  /* 8-word TX FIFO */
    sm_config_set_clkdiv(&c, 1.0f);

    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, data_pin + 1);
    pio_gpio_init(pio, data_pin + 2);
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 3, true);
    pio_sm_set_consecutive_pindirs(pio, sm, clk_pin, 1, false);
    pio_gpio_init(pio, clk_pin);
    gpio_disable_pulls(clk_pin);                     /* RP2350-E9: no pull-down on an input */

    pio_sm_init(pio, sm, offset, &c);
}
%}
